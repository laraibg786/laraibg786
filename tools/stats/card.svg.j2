{#- Follow-up card. Rendered by cards.py; every number and position comes from its context. -#}
{%- macro icon(kind, x, y) -%}
{%- set col = colors[kind] -%}
<circle cx="{{ x + 6 }}" cy="{{ y - 4 }}" r="6.2" fill="none" stroke="{{ col }}" stroke-width="1.2" opacity=".9"/>
{%- if kind == "open" %}
<circle cx="{{ x + 6 }}" cy="{{ y - 4 }}" r="1.6" fill="{{ col }}"/>
{%- elif kind == "closed" %}
<path d="M{{ x + 3.5 }} {{ y - 4 }} l2 2 l3.5 -3.5" fill="none" stroke="{{ col }}" stroke-width="1.4"/>
{%- elif kind == "merged" %}
<circle cx="{{ x + 3.5 }}" cy="{{ y - 8 }}" r="1.3" fill="{{ col }}"/><circle cx="{{ x + 3.5 }}" cy="{{ y - 1 }}" r="1.3" fill="{{ col }}"/><circle cx="{{ x + 9 }}" cy="{{ y - 4 }}" r="1.3" fill="{{ col }}"/>
<path d="M{{ x + 3.5 }} {{ y - 6.7 }} V{{ y - 2.3 }} M{{ x + 3.5 }} {{ y - 4 }} H{{ x + 7.7 }}" stroke="{{ col }}" fill="none"/>
{%- else %}
<path d="M{{ x + 3.5 }} {{ y - 7 }} l5 5 m0 -5 l-5 5" stroke="{{ col }}" stroke-width="1.4" fill="none"/>
{%- endif %}
{%- endmacro -%}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="{{ title }}">
<style>
@font-face{font-family:'JB';font-weight:400;src:url(data:font/woff2;base64,{{ font_regular }}) format('woff2')}
@font-face{font-family:'JB';font-weight:600;src:url(data:font/woff2;base64,{{ font_semibold }}) format('woff2')}
:root{ {{- theme.vars -}} }
text{font-family:'JB','JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;fill:var(--fg)}
.mu{fill:var(--mu)}.t{font-size:14px;font-weight:600}.s{font-size:11.5px}.n{font-size:11.5px;font-weight:600}.ac{fill:var(--ac)}
</style>
<rect x=".5" y=".5" width="{{ width - 1 }}" height="{{ height - 1 }}" rx="6" fill="var(--bg)" stroke="var(--bd)"/>
<text class="t" x="{{ width / 2 }}" y="28" text-anchor="middle" style="font-size:16px">{{ title }}</text>
<text class="s mu" x="{{ width / 2 }}" y="48" text-anchor="middle">{{ subtitle }}</text>
{% for col in columns %}
<text class="t ac" x="{{ col.x + col_width / 2 }}" y="82" text-anchor="middle">{{ col.name }}</text>
{% for g in col.groups %}
<text class="t ac" x="{{ col.x }}" y="{{ g.y + 4 }}">{{ g.name }}</text>
<clipPath id="{{ g.id }}"><rect x="{{ col.x }}" y="{{ g.y + 12 }}" width="{{ col_width }}" height="6" rx="3"/></clipPath>
<g clip-path="url(#{{ g.id }})">
<rect x="{{ col.x }}" y="{{ g.y + 12 }}" width="{{ col_width }}" height="6" fill="var(--bd)"/>
{%- for s in g.segments %}
<rect x="{{ s.x }}" y="{{ g.y + 12 }}" width="{{ s.w }}" height="6" fill="{{ s.color }}"/>
{%- endfor %}
</g>
{% for it in g.rows -%}
{{ icon(it.icon, it.x, it.y) }}
<text class="n" x="{{ it.x + 18 }}" y="{{ it.y }}">{{ it.count }}</text>
<text class="s mu" x="{{ it.label_x }}" y="{{ it.y }}">{{ it.label }}</text>
{% endfor %}
{% endfor %}
{% endfor %}
<text class="s mu" x="{{ width / 2 }}" y="{{ footer_y }}" text-anchor="middle">{{ footer }}</text>
</svg>
